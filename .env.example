# ==============================================================================
# InfoCVE Environment Configuration (.env.example)
# ==============================================================================
# Salin file ini menjadi `.env.local` untuk development lokal:
#   cp .env.example .env.local
#
# Seluruh credential bersifat opsional untuk menjalankan aplikasi secara default.
# InfoCVE dapat langsung dijalankan tanpa API key (mode unauthenticated).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL Aplikasi (Wajib untuk Produksi, Opsional untuk Lokal)
# ------------------------------------------------------------------------------
# Digunakan untuk canonical link, sitemap.xml, robots.txt, dan OpenGraph preview.
# Ganti dengan domain produksi Anda saat dideploy (misal: https://infocve.id).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. National Vulnerability Database (NVD NIST API v2.0)
# ------------------------------------------------------------------------------
# Kunci API resmi dari NIST untuk mengakses feed CVE.
# Sifat: OPSIONAL.
# - Tanpa Kunci: Aplikasi tetap berjalan normal dengan rate limit 5 req / 30 detik.
# - Dengan Kunci: Rate limit meningkat menjadi 50 req / 30 detik (jauh lebih cepat).
# Dapatkan kunci API gratis dari NIST di:
# https://nvd.nist.gov/developers/request-an-api-key
#
# PENTING: Kunci ini hanya digunakan di sisi server dan tidak pernah terekspos ke klien.
# NVD_API_KEY=

# ------------------------------------------------------------------------------
# 3. GitHub Security Advisories (GHSA)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic atau fine-grained token publik).
# Sifat: OPSIONAL.
# Digunakan untuk memperkaya relasi paket open-source dan advisories GitHub.
# Dapatkan token di: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_your_github_token_here

# ------------------------------------------------------------------------------
# 4. Kemanan Endpoint Sinkronisasi (POST /api/sync)
# ------------------------------------------------------------------------------
# Token rahasia untuk memproteksi trigger sinkronisasi database lokal.
# Sifat: DIREKOMENDASIKAN UNTUK PRODUKSI.
# Jika diisi, pemanggilan POST /api/sync wajib menyertakan header:
#   Authorization: Bearer <ADMIN_SECRET>
# ADMIN_SECRET=

# ------------------------------------------------------------------------------
# 5. Penyimpanan Database SQLite Lokal
# ------------------------------------------------------------------------------
# Lokasi direktori penyimpanan file SQLite (`infocve.sqlite`).
# Sifat: OPSIONAL (Default: ./data).
# Berguna untuk lingkungan Docker, persistent volume mount, atau server VPS.
# INFOCVE_DATA_DIR=./data

# 5a. Penyimpanan persisten Vercel (riwayat scanner & cache sampel NVD)
# Isi dengan pooled connection string dari Neon, server-side saja.
# DATABASE_URL=
# Neon branch/database test terpisah dari produksi.
# TEST_DATABASE_URL=

# ------------------------------------------------------------------------------
# 6. Sistem Notifikasi & Webhook Alert (Opsional)
# ------------------------------------------------------------------------------
# Mengaktifkan engine notifikasi untuk kerentanan Kritis atau CISA KEV baru.
# NOTIFICATIONS_ENABLED=false
# NOTIFICATION_WEBHOOK_URL=https://discord.com/api/webhooks/... (atau Slack / generic webhook)

# ------------------------------------------------------------------------------
# 7. Interval Jadwal Sinkronisasi (Menit)
# ------------------------------------------------------------------------------
# SYNC_INTERVAL_MINUTES=60

# ------------------------------------------------------------------------------
# 8. Automatic CVE Translation (opsional; LibreTranslate-compatible endpoint)
# ------------------------------------------------------------------------------
# Tanpa URL provider, CVE tetap tersimpan dan status terjemahan akan ditandai FAILED.
# Terjemahan disimpan di cache SQLite dan dicoba ulang melalui antrean persisten.
# INFOCVE_TRANSLATION_URL=https://translate.internal.example/translate
# INFOCVE_TRANSLATION_API_KEY=
# INFOCVE_TRANSLATION_RETRY_DELAY_MS=400

# ------------------------------------------------------------------------------
# 9. Retensi dan Batas Pemindaian Dependency
# ------------------------------------------------------------------------------
# Masa simpan riwayat pemindaian dependency sebelum dihapus otomatis (dalam hari).
# Sifat: OPSIONAL (Default: 30).
# DEPENDENCY_SCAN_RETENTION_DAYS=30

# ------------------------------------------------------------------------------
# 10. Rate Limiting API (Opsional)
# ------------------------------------------------------------------------------
# Batas request per jendela waktu (window) per IP address.
# SYNC_RATE_LIMIT_MAX=5
# SCAN_RATE_LIMIT_MAX=10

